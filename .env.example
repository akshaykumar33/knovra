# ==============================================================================
# Knovra Environment Configuration Template
# All default values are configured for local development.
# ==============================================================================

# Project & Environment
KNOVRA_ENV=development
KNOVRA_PROJECT_NAME=knovra-dev
KNOVRA_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PostgreSQL + pgvector (Transactional Truth & Vector Memory)
# ------------------------------------------------------------------------------
POSTGRES_USER=knovra
POSTGRES_PASSWORD=knovra_dev_password
POSTGRES_DB=knovra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knovra:knovra_dev_password@localhost:5432/knovra

# ------------------------------------------------------------------------------
# Neo4j (Context Knowledge Graph)
# ------------------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=knovra_dev_password
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_URI=bolt://localhost:7687

# ------------------------------------------------------------------------------
# Redis (Cache, Locks & Working Memory)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# NATS JetStream (Asynchronous Event Streaming)
# ------------------------------------------------------------------------------
NATS_HOST=localhost
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

# ------------------------------------------------------------------------------
# MinIO / S3 (Raw Artifacts & Conversation Transcripts)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=knovra-artifacts

# ------------------------------------------------------------------------------
# Subsystem Ports & Service URLs
# ------------------------------------------------------------------------------
PORT_WEB=3000
PORT_API=4000
PORT_RUNTIME_DAEMON=8080
PORT_CONTEXT_ENGINE=8000
PORT_CODE_INDEXER=50051

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
RUNTIME_DAEMON_URL=http://localhost:8080
CONTEXT_ENGINE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Observability (OpenTelemetry)
# ------------------------------------------------------------------------------
OTEL_SERVICE_NAME=knovra
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on
