.knovra/

# Generated artifacts: release tarballs, QA screenshots, probe output, local databases.
# Evidence belongs attached to a pull request, not in the repository history.
artifacts/

# Design reference captures. Large binaries, and `public/` is served to end users —
# internal art direction must not ship with the product. Keep them locally or in
# design storage; docs/design/reference-manifest.json records what they were.
apps/web/public/design-reference/

/apps/web/.next-redesign/
/apps/web/.next-review/
/apps/web/.next-library/
/apps/web/.next-audit/
