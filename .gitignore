# Python packaging directories — SCOPED to the only Python service on purpose.
# Unscoped, these are generic English words that silently swallow real source:
# a bare `lib/` hid apps/web/lib/{api,confetti,data}.ts, so the branch typechecked
# locally and failed CI with "Cannot find module '../../lib/data'". Keep them
# anchored; never reintroduce an unanchored directory name here.
services/context-engine/env/
services/context-engine/ENV/
services/context-engine/develop-eggs/
services/context-engine/downloads/
services/context-engine/eggs/
services/context-engine/.eggs/
services/context-engine/lib/
services/context-engine/lib64/
services/context-engine/parts/
services/context-engine/sdist/
services/context-engine/var/
services/context-engine/wheels/
services/context-engine/.installed.cfg

# Go
services/runtime/bin/
*.test
*.out

# Environment & Secrets (see docs/GIT_RULES.md §6 — ignoring is a backstop, not the gate)
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.cert
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
.npmrc
.pypirc
secrets.json
service-account*.json
credentials*.json
*.tfstate
*.tfstate.backup

