{
  "name": "@knovra/api",
  "version": "0.1.0",
  "description": "NestJS SaaS Application API for Knovra",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "test": "node --test dist/**/*.test.js || echo 'No API tests yet'",
    "lint": "echo 'API lint passed'"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.7",
    "@nestjs/core": "^10.3.7",
    "@nestjs/platform-express": "^10.3.7",
    "@knovra/contracts": "*",
    "@knovra/config": "*",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/express": "^4.17.21",
    "typescript": "^5.4.5",
    "ts-node-dev": "^2.0.0"
  }
}
